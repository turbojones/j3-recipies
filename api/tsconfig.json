{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": [
    "./**/*.ts"
  ]
}